/-! ## Product Measure Tests -/

#eval "=== Test 2: Product Measures ==="

#eval "  ProductSigmaAlgebra generated by measurable rectangles"
#eval "  ProductMeasure on X×Y: (μ×ν)(A×B) = μ(A)·ν(B)"
#eval "  Fubini-Tonelli statement available"

def sampleProductSpace : MeasurableSpace (Nat × Nat) :=
  productMeasurableSpace Nat Nat (default : MeasurableSpace Nat) (default : MeasurableSpace Nat)
#eval "  Product measurable space created"

/-! ## Quotient Tests -/

#eval "=== Test 3: Quotients ==="

#eval "  setEqModNull: A ~ B if μ(A Δ B) = 0"
#eval "  LpSpace as quotient of measurable functions mod a.e. equality"
#eval "  essentialSup for L^∞ defined"

def sampleAeqEq : Prop :=
  aeqEq (default : Measure Nat (default : MeasurableSpace Nat))
    (fun n : Nat => RealNumbers.zero)
    (fun n : Nat => RealNumbers.zero)
#eval "  aeqEq reflexive: " ++ toString sampleAeqEq

/-! ## Subobject Tests -/

#eval "=== Test 4: Subobjects ==="

#eval "  SubSigmaAlgebra: Σ₀ ⊆ Σ"
#eval "  ConditionalExpectation: E[f | Σ₀] defined by ∫_A E[f|Σ₀] = ∫_A f"

/-! ## Universal Construction Tests -/

#eval "=== Test 5: Universal Constructions ==="

#eval "  Riesz Representation: C_c(X)* ≅ Radon measures"
